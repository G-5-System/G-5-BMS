@model G_5_BMS.Models.Announcement
@{
    ViewData["Title"] = "Announcements";
    ViewData["ShowSecondNavbar"] = true; 
}



<link rel="stylesheet" href="~/css/Announcement.css" asp-append-version="true" />

<div class="container">
    <div class="announcement-card">
        <div class="announcement-list">
            @foreach (var HomeContents in Model.Announcements) // Loop through each announcement
            {
               <div class="individual-announcement">
                    <div class="announcement-item-card">
                        <div class="announcement-header">
                            <div class="announcement-title">
                                <h4>>@HomeContents.Title</h4>
                                <p>@HomeContents.Body</p>
                            </div>
                            <div class="announcement-date-time">
                                <p class="date-time">@HomeContents.DateTime.ToString("dd MMMM yyyy hh:mm tt")</p>
                                
                            </div>
                        </div>
                        <div class="announcement-location">
                            <p><strong>Location:</strong></p>
                            <p>@HomeContents.Location</p>
                        </div>
                    </div>
                </div>
            }
       
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/HomeLayout.js" asp-append-version="true"></script>